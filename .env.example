# PremierPro MCP Server — Environment Variables

# ─── Interactive CLI authentication ───
# Claude/Codex OAuth subscriptions cannot be reused as API keys.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MODEL=provider-model-id

# ─── Go Orchestrator ───
MCP_TRANSPORT=stdio
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8080
MCP_LOG_LEVEL=info
MCP_PAGE_SIZE=100
MCP_TOOL_PROFILE=standard
RUST_ENGINE_ADDR=localhost:50052
PYTHON_INTEL_ADDR=localhost:50053
TS_BRIDGE_ADDR=localhost:50054
RUST_ENGINE_TIMEOUT=30
PYTHON_INTEL_TIMEOUT=60
TS_BRIDGE_TIMEOUT=30

# ─── Rust Engine ───
MEDIA_ENGINE_HOST=127.0.0.1
MEDIA_ENGINE_PORT=50052
MEDIA_ENGINE_LOG_LEVEL=info
MEDIA_ENGINE_LOG_JSON=false

# ─── Python Intelligence ───
PYTHON_BIN=python3
INTEL_GRPC_HOST=127.0.0.1
INTEL_GRPC_PORT=50053
INTEL_LOG_LEVEL=INFO
# INTEL_OPENAI_API_KEY=sk-...
# INTEL_ANTHROPIC_API_KEY=sk-ant-...

# ─── TypeScript Bridge ───
BRIDGE_GRPC_HOST=127.0.0.1
BRIDGE_GRPC_PORT=50054
BRIDGE_LOG_LEVEL=info
BRIDGE_MODE=cep
BRIDGE_CEP_WS_PORT=9801
# Go, the bridge, and the CEP panel automatically share this per-user token file.
# PREMIERE_MCP_TOKEN_FILE="$HOME/.premierpro-mcp/cep-token"
# Alternatively, set the same explicit secret for both processes:
# BRIDGE_CEP_TOKEN=replace-with-a-long-random-secret
# MCP_CEP_TOKEN=replace-with-a-long-random-secret
PREMIERE_PATH="/Applications/Adobe Premiere Pro 2026/Adobe Premiere Pro 2026.app"
# Named premiere_export presets must resolve to real Adobe Media Encoder .epr files.
# PREMIERE_EXPORT_PRESET_H264_1080P=/absolute/path/to/h264-1080p.epr
# PREMIERE_EXPORT_PRESET_H264_4K=/absolute/path/to/h264-4k.epr
# PREMIERE_EXPORT_PRESET_PRORES_422=/absolute/path/to/prores-422.epr
# PREMIERE_EXPORT_PRESET_PRORES_4444=/absolute/path/to/prores-4444.epr
# PREMIERE_EXPORT_PRESET_DNX_HR=/absolute/path/to/dnx-hr.epr
# PREMIERE_EXPORT_PRESET_CUSTOM=/absolute/path/to/custom.epr

# ─── Docker analysis backends ───
# Use absolute paths. They are mounted at the identical container path so RPC
# file names remain valid on both the host and analysis service.
# PREMIERE_MEDIA_ROOT=/absolute/path/to/media
# PREMIERE_OUTPUT_ROOT=/absolute/path/to/output
